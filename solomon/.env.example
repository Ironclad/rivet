# Solomon v4.0 - Environment Variables Example
# Copy this file to .env and fill in your values

# ===== REQUIRED =====
SECRET_KEY=change-me-to-a-32-byte-random-string
JWT_SECRET=another-32-byte-secret-for-jwt-tokens

# ===== DATABASE =====
DATABASE_URL=sqlite:///instance/solomon.db

# ===== OPENAI (optional - enables LLM features) =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ===== STRIPE (optional - card payments) =====
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== CRYPTO RECEIVING ADDRESSES (production) =====
CRYPTO_BTC_ADDRESS=
CRYPTO_ETH_ADDRESS=
CRYPTO_USDT_ADDRESS=
CRYPTO_USDC_ADDRESS=

# ===== BANK WIRE INFO (production) =====
BANK_NAME=Solomon Bank
BANK_ACCOUNT_NAME=Solomon LLC
BANK_ACCOUNT_NUMBER=000000000
BANK_ROUTING=000000000
BANK_SWIFT=SOLOMONUS

# ===== 2FA =====
TOTP_ISSUER=Solomon

# ===== TELEGRAM BOT (optional) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== TWILIO (optional SMS) =====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ===== EXTERNAL APIs =====
GOVDEALS_API_KEY=
CRYPTOPANIC_API_KEY=

# ===== FEATURE FLAGS =====
ENABLE_SCHEDULER=true
ENABLE_WEBSOCKET=false
FLASK_ENV=production
PORT=5000
